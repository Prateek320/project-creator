# Which environment this is: demo | development | staging | production.
# Leave unset only for zero-setup local runs (no DATABASE_URL): it then defaults to "demo".
APP_ENV=

# Leave DATABASE_URL empty to use the embedded PGlite database in ./.data (zero setup).
# Set it to a real Postgres URL for staging/production, e.g. postgres://user:pass@localhost:5432/project_creator
# Against Postgres, apply migrations with `npm run db:migrate` (they never run at boot).
DATABASE_URL=

# HMAC secret for the demo session cookie. Required outside demo/development.
# Generate: openssl rand -base64 32
SESSION_SECRET=

# Bearer token the scheduler sends to /api/jobs/run. Required outside demo/development.
# Generate: openssl rand -base64 32
CRON_SECRET=

# 32-byte key (base64) that encrypts secrets at rest, e.g. brand webhook signing secrets.
# Required outside demo/development. Generate: openssl rand -base64 32
# Changing it makes existing encrypted secrets unreadable: brands must rotate theirs.
ENCRYPTION_KEY=

# Payment + social providers stay in mock mode until approvals and legal review exist.
PAYMENT_PROVIDER=mock
SOCIAL_PROVIDER=mock

# Clerk (managed sign-in). Required in staging and production: without both keys sign-in is off there.
# Leave empty in the demo, which uses the seeded account picker even if keys are set.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Comma-separated emails that become platform operations (admin) at sign-up. Must be verified in Clerk.
OPS_EMAILS=

# Email. mock (default) records emails in memory; production refuses to use it.
# resend: needs RESEND_API_KEY and a verified sender domain in EMAIL_FROM, e.g. "proovd <hello@mail.proovd.in>".
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=
# Public base URL used in email links. Required outside demo/development.
APP_URL=

# Shown on /privacy as the contact for privacy questions and complaints.
PRIVACY_CONTACT_EMAIL=
